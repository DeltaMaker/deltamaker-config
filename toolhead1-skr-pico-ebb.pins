# Date: 9/16/2025
#
# DeltaMaker Toolhead Pin Definitions file: toolhead1-skr-pico-ebb.pins
#
# Controller board specific: DeltaMaker MCU pin definitions for SKR Pico and EBB36.
#
# SKR Pico Toolhead Objects
# Extruder, Fan, Probe
#
# Experimental use of EBB36 over USB to provide Extruder 1 Stepper motor driver with SKR-Pico. 
# SKR-Pico provides Extruder 0 Stepper motor driver, and thermistor/heater control for both extruders.
# EBB36 requires 24v power via 4-pin MicroFit 3 connector in addition to USB connection to Raspberry Pi.

##### EXTRUDER MOTOR/HEATER/SENSOR #####
[extruder1]
step_pin: ebb36_1:PD0   # EXT_STEP
dir_pin: ebb36_1:PD1   # EXT_DIR
enable_pin: !ebb36_1:PD2  # EXT_EN
heater_pin: gpio23 	# HE1,  HE
sensor_pin: gpio26 	# TH1
#heater_pin: gpio21	# HE0,  HB
#sensor_pin: gpio27 # TH0

[tmc2209 extruder1]
uart_pin: ebb36_1:PA15  # EXT_UART
stealthchop_threshold: 0
run_current: 0.68

##### EXTRUDER1 FAN #####
[heater_fan extruder1_fan]
pin: ebb36_1:PA0    # FAN1
heater: extruder1

