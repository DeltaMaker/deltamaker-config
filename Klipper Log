	{% set z_diff = printer.gcode_move.position.z - offsets.z %}
	{% set null = offsets.update({'probe_z': -z_diff|float|round(5)}) %}
	
	SAVE_VARIABLE VARIABLE={offset_key} VALUE="{offsets | pprint | replace("\n", "") | replace("\"", "\\\"")}"

