[gcode_macro PAUSE2]
description = Pause the current print
gcode = 
	{% set max_y = printer.toolhead.axis_maximum.y|float %}
	{% set max_z = printer.toolhead.axis_maximum.z|float %}
	
	{% set x = params.X|default(0) %}
	{% set y = params.Y|default(max_y * 0.90) %}
